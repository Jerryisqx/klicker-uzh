// schema.prisma
generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("postgresql://klicker:klicker@localhost:5432/klicker")
}

model Element {
  id        String   @id @default(uuid())
  content   String
  options   Json
  type      String
  name      String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isAI      Boolean  @default(true)
}